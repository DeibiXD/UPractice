# Copiar a .env y completar las tres contraseñas antes de docker compose up --build.
# .env es local y está ignorado por Git. Use contraseñas distintas de 8 a 64
# caracteres, con mayúscula, minúscula y número. Para estos comandos evite ;,
# comillas y $ en las contraseñas.
POSTGRES_PASSWORD=
SUPERADMIN_PASSWORD=
DEMO_PASSWORD=

# Puertos locales; la API y PostgreSQL solo se publican en 127.0.0.1.
API_PORT=8080
POSTGRES_PORT=5433

# Opcionales en Docker/Development: dejar AMBAS vacías genera claves temporales;
# los tokens dejan de servir al reiniciar la API. Para conservarlos, generar
# dos valores distintos y completar ambas claves. Cada ejecución produce una clave:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Firma y cifrado deben ser distintas. En Render se usan claves nuevas, no estas.

JWT_CLAVE_FIRMA=
JWT_CLAVE_CIFRADO=
