# Copiar a .env (no se sube al repositorio) y llenar con valores propios.
# Las claves JWT se generan con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Firma y cifrado deben ser distintas. En Render se usan claves nuevas, no estas.

SUPERADMIN_PASSWORD=
JWT_CLAVE_FIRMA=
JWT_CLAVE_CIFRADO=
